{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(ls:*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(cat:*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf /*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$TOOL_INPUT\" | grep -qE '(git\\s+push\\s+--force|git\\s+reset\\s+--hard|git\\s+clean\\s+-fd|git\\s+checkout\\s+--\\s+\\.|rm\\s+-rf\\s+/)'; then echo 'BLOCKED: Destructive git operation detected. Please confirm with the user first.' >&2; exit 2; fi"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-coderabbit-pass.py\"",
            "timeout": 60,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-main-branch.py\"",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
